# Native codec2 builds (large, can be re-generated from source, and contain build artifacts)
/ios/codec2/
/macos/codec2/
/android/app/src/main/jni/

# Backend services (proprietary, not part of public repo)
/backend/
/tools/
/tool/l10n_audit.py

# Local Rust experiments (cargo build artifacts) — not part of the app
/tapo/

# Firebase Hosting content (landing page, legal docs, admin tools)
/web/
/web_admin/
/web_marketing/
/web-admin-redirect/
/web-bugs-redirect/
/web-redirect/
/web-sprints-redirect/

# Environment files
.env
.env.*
!.env.ci
!.env.example
.env.local

# Signing keys and certificates
*.keystore
*.jks
*.p12
*.pem
!*.pem.example

# Firebase app config files (contain API keys and OAuth client IDs)
# Note: firebase_options.dart must stay tracked — it's compiled into the binary (GPL requirement).
# Firebase API keys are not secrets; security is enforced by Firestore rules + App Check.
**/google-services.json
**/GoogleService-Info.plist

# Old root-level backend services (moved to backend/)
/functions/
/marketplace-api/
/mesh-observer/

# Firebase project config (rules, indexes, project bindings)
firebase.json
firestore.rules
firestore.indexes.json
storage.rules
.firebaserc
docker-compose.yml

# Firestore security rule tests (enterprise, private repo only)
/test/firestore_rules/

# Scratch probe tests (throwaway, never committed)
/test/tmp_probe/

# Firebase/GCP service account keys (NEVER commit these!)
*-firebase-adminsdk-*.json
firebase-service-account.json
**/service-account*.json
**/*-service-account.json
# Scripts: blanket exclude, explicit allowlist for CI / contributor-facing tools
/scripts/*
!/scripts/check-licenses.sh
!/scripts/check_translation_coverage.py
!/scripts/fetch_device_hardware.sh
!/scripts/generate_protos.sh
!/scripts/hooks/
/scripts/hooks/*
!/scripts/hooks/socialmesh-lint.sh
/artifacts/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code config (may contain env references, internal tooling paths)
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Test-generated widget templates
assets/widget_templates/*.json

# Internal docs (keep public-facing docs for repo links)
/docs/
!/docs/ARCHITECTURE.md
!/docs/BACKEND.md
!/docs/RELEASING.md
!/docs/TRANSLATION_GUIDE.md

# Scripts dependencies
/scripts/node_modules/
/scripts/package-lock.json
android/key.properties
.sandbox/

# Agent skills (Flutter/Dart official skills); synced via scripts/sync-private.sh
/.agents/
/skills-lock.json

# xcodebuild MCP per-developer session defaults (machine-local paths)
.xcodebuildmcp/
logs_output.txt

# Local security review reports may describe unresolved vulnerabilities.
/socialmesh-security-assessment.md
