# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Fix for TSBackgroundFetch static framework conflict with use_frameworks!
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name.eql?('background_fetch')
      def pod.build_type
        Pod::BuildType.static_library
      end
    end
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Enable microphone permission for permission_handler plugin.
    # Without this macro the plugin returns denied without ever showing
    # the native iOS permission dialog.
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_MICROPHONE=1',
      ]
    end


  end

  # Re-sign embedded frameworks workaround.
  #
  # `package:objective_c` (and other native-asset Dart FFI packages)
  # ship their iOS frameworks adhoc-signed (TeamIdentifier=not set).
  # iOS refuses to install adhoc-signed binaries on a physical device
  # and surfaces the failure as `0xe8008014` ("invalid signature") on
  # the embedded framework. The simulator doesn't enforce this so sim
  # builds work fine.
  #
  # Fix: add a Run Script build phase to the Runner target that runs
  # after Embed Frameworks and re-signs every framework in the
  # frameworks folder with the build's signing identity. The .app's
  # outer signature is then re-sealed by Xcode's normal "Sign on Copy"
  # path, so install succeeds.
  #
  # This block is idempotent — if the phase already exists with the
  # same body, no change is made.
  runner_path = File.join(File.dirname(__FILE__), 'Runner.xcodeproj')
  if File.exist?(runner_path)
    runner_project = Xcodeproj::Project.open(runner_path)
    runner_target = runner_project.targets.find { |t| t.name == 'Runner' }
    if runner_target
      phase_name = '[Socialmesh] Re-sign Embedded Frameworks'
      script_body = <<~SH
        # Workaround for package:objective_c shipping its iOS framework
        # adhoc-signed; iOS device install otherwise fails with 0xe8008014.
        # Re-sign every embedded framework with the build's signing identity.
        set -e
        if [ -z "${EXPANDED_CODE_SIGN_IDENTITY}" ]; then
          echo "EXPANDED_CODE_SIGN_IDENTITY empty (simulator build) — skipping resign"
          exit 0
        fi
        FRAMEWORKS_DIR="${BUILT_PRODUCTS_DIR}/${FRAMEWORKS_FOLDER_PATH}"
        [ -d "$FRAMEWORKS_DIR" ] || exit 0
        find "$FRAMEWORKS_DIR" -maxdepth 1 -name "*.framework" -print0 | while IFS= read -r -d '' fw; do
          echo "Re-signing $fw with ${EXPANDED_CODE_SIGN_IDENTITY}"
          /usr/bin/codesign --force --sign "${EXPANDED_CODE_SIGN_IDENTITY}" \\
                   --preserve-metadata=identifier,entitlements,flags \\
                   --timestamp=none \\
                   "$fw"
        done
      SH
      existing = runner_target.shell_script_build_phases.find { |p| p.name == phase_name }
      if existing
        if existing.shell_script != script_body
          existing.shell_script = script_body
          runner_project.save
        end
      else
        phase = runner_target.new_shell_script_build_phase(phase_name)
        phase.shell_script = script_body
        runner_project.save
      end
    end
  end
end
